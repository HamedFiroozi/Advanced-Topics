def circuit(a, b, c, entangled=True):
    from qiskit import QuantumCircuit

    qc = QuantumCircuit(2)
    qc.ry(float(a), 0)
    qc.ry(float(b), 1)
    if entangled:
        qc.cx(0, 1)
    qc.ry(float(c), 0)
    return qc


def verify_local():
    import qiskit
    from qiskit import QuantumCircuit
    from qiskit.quantum_info import Statevector, SparsePauliOp

    data = json.loads((BASE / "results.json").read_text())
    mo = data["models"][2]
    t = np.linspace(0, 2, 201)
    V, _ = features(t, 5)
    th = np.array(mo["theta"]).reshape(2, 3, 6)
    angles = np.einsum("td,pgd->tpg", V, th)
    q = evaluate(mo["theta"], t, 4, "entangled", return_q=True)[0]
    probs = np.zeros((len(t), 2, 4))
    maxerr = 0.0
    obs = [SparsePauliOp("IZ"), SparsePauliOp("ZI")]
    for i in range(len(t)):
        for p in range(2):
            st = Statevector.from_instruction(circuit(*angles[i, p]))
            probs[i, p] = st.probabilities()
            pred = np.array([st.expectation_value(o).real for o in obs])
            maxerr = max(maxerr, float(np.max(abs(pred - q[i, 2 * p : 2 * p + 2]))))
    data["checks"]["qiskit_readout_max_error"] = maxerr
    data["versions"]["qiskit"] = qiskit.__version__
    # Check time derivatives against centered differences at interior off-grid points.
    tt = np.array([0.137, 0.731, 1.413, 1.917])
    h = 1e-5
    yp, _ = evaluate(mo["theta"], tt + h, 4, "entangled")
    ym, _ = evaluate(mo["theta"], tt - h, 4, "entangled")
    _, dy = evaluate(mo["theta"], tt, 4, "entangled")
    data["checks"]["time_derivative_max_error"] = float(
        np.max(abs((yp - ym) / (2 * h) - dy))
    )
    # Frozen-parameter joint measurement, keeping correlations between readouts.
    eig = np.array([[1, 1], [-1, 1], [1, -1], [-1, -1]])
    ref = classical(3, t)
    rng = np.random.default_rng(8143)
    rows = []
    flip = 0.01
    depol = 0.02
    transition = np.array(
        [
            [
                (1 - flip) ** (2 - (i ^ j).bit_count()) * flip ** ((i ^ j).bit_count())
                for j in range(4)
            ]
            for i in range(4)
        ]
    )
    for label, S in [
        ("ideal shots", 1024),
        ("ideal shots", 4096),
        ("ideal shots", 16384),
        ("illustrative noise", 4096),
    ]:
        P = (
            probs
            if label == "ideal shots"
            else ((1 - depol) * probs + depol / 4) @ transition
        )
        errors = []
        for repeat in range(200):
            counts = np.array(
                [[rng.multinomial(S, pp / pp.sum()) for pp in ppair] for ppair in P]
            )
            qh = (counts @ eig / S).reshape(len(t), 4)
            yy = t[:, None] * qh
            yy[:, 0] += 1
            errors.append(np.mean((yy - ref) ** 2))
        rows.append(
            {
                "model": label,
                "shots": S,
                "mean_mse": float(np.mean(errors)),
                "sd_mse": float(np.std(errors, ddof=1)),
            }
        )
    data["hierarchy_shots"] = rows
    # Independent angle-by-angle parameter-shift check.
    max_ps = 0.0
    for ang in np.random.default_rng(47).uniform(-3, 3, (10, 3)):
        for gate in range(3):
            ap = ang.copy()
            am = ang.copy()
            ap[gate] += np.pi / 2
            am[gate] -= np.pi / 2
            bp = ang.copy()
            bm = ang.copy()
            bp[gate] += 1e-6
            bm[gate] -= 1e-6
            for obsname in ["IZ", "ZI"]:
                op = SparsePauliOp(obsname)
                ps = (
                    Statevector(circuit(*ap)).expectation_value(op)
                    - Statevector(circuit(*am)).expectation_value(op)
                ).real / 2
                fd = (
                    Statevector(circuit(*bp)).expectation_value(op)
                    - Statevector(circuit(*bm)).expectation_value(op)
                ).real / (2e-6)
                max_ps = max(max_ps, abs(ps - fd))
    data["checks"]["parameter_shift_max_error"] = float(max_ps)
    W = np.diag([1, 3, 5, 7])
    A = matrix(3)
    data["checks"]["dissipation_identity_max_error"] = float(
        np.max(abs(W @ A + A.T @ W + 0.4 * W))
    )
    (BASE / "results.json").write_text(json.dumps(data, indent=2))
    print(json.dumps({"checks": data["checks"], "shots": rows}, indent=2))
    # Circuit diagram uses an actual representative input; parameter labels in report are general.
    qc = circuit(*angles[100, 0])
    (BASE / "circuit.txt").write_text(str(qc.draw(output="text")))


