def plot_saved_results():
    out = json.loads((BASE / "results.json").read_text())
    test = np.linspace(0, 2, 201)
    far = np.linspace(0, 6, 601)
    theta = np.asarray(out["scalar"]["theta"])

    def scalar_curve(x):
        q = np.cos(np.polynomial.polynomial.polyval(x, theta))
        return 1 + x * (q - 1) / 2

    y = scalar_curve(test)
    yf = scalar_curve(far)
    fig, ax = plt.subplots(1, 2, figsize=(10, 3.3))
    ax[0].plot(test, np.exp(-test), label="Exact")
    ax[0].plot(test, y, "--", label="Residual-trained circuit")
    ax[0].set(xlabel="x (dimensionless)", ylabel="y(x)")
    ax[0].legend()
    ax[1].plot(far, np.exp(-far), label="Exact")
    ax[1].plot(far, yf, label="Same trained parameters")
    ax[1].axvspan(0, 2, alpha=0.12, color="gray", label="Training interval")
    ax[1].set(xlabel="x (dimensionless)", ylabel="y(x)", ylim=(-5, 1.2))
    ax[1].legend(fontsize=8)
    fig.tight_layout()
    fig.savefig(BASE / "figures/scalar.pdf")
    plt.close(fig)
    fig, axs = plt.subplots(2, 2, figsize=(10, 6), sharex=True)
    model = out["models"][2]
    v, d = evaluate(model["theta"], test, 4, "entangled")
    ref = classical(3, test)
    true = infinite(3, test)
    for j, ax in enumerate(axs.flat):
        ax.plot(test, true[:, j], label="Infinite hierarchy")
        ax.plot(test, ref[:, j], "--", label="Classical P3")
        ax.plot(test, v[:, j], ":", lw=2, label="Two-qubit ansatz")
        ax.set(xlabel="t (dimensionless)", ylabel=f"M{j}(t)")
        ax.legend(fontsize=7)
    fig.tight_layout()
    fig.savefig(BASE / "figures/hierarchy.pdf")
    plt.close(fig)
    fig, ax = plt.subplots(1, 2, figsize=(10, 3.2))
    for N in [1, 2, 3, 5]:
        ax[0].semilogy(
            test,
            np.maximum(abs(classical(N, test)[:, 0] - infinite(N, test)[:, 0]), 1e-16),
            label=f"P{N}",
        )
    ax[0].set(xlabel="t (dimensionless)", ylabel="Absolute closure error in M0")
    ax[0].legend()
    for mo in out["models"]:
        if mo["N"] == 3:
            yy, _ = evaluate(mo["theta"], test, 4, mo["kind"])
            ax[1].semilogy(
                test,
                np.maximum(np.linalg.norm(yy - ref, axis=1), 1e-16),
                label=mo["kind"],
            )
    ax[1].set(xlabel="t (dimensionless)", ylabel="Euclidean error against classical P3")
    ax[1].legend()
    fig.tight_layout()
    fig.savefig(BASE / "figures/errors.pdf")
    plt.close(fig)


