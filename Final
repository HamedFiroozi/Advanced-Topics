def analyze_hardware():
    base = BASE
    m = json.loads((base / "hardware_data/main/ibm_result.json").read_text())
    d = np.load(base / "hardware_data/main/ibm_values.npz", allow_pickle=False)
    t = d["t"]
    theta = np.asarray(m["theta"])
    V = np.array([(t - 1) ** j for j in range(6)]).T
    angles = np.einsum("td,pgd->tpg", V, theta)
    q = np.empty((len(t), 4))
    for p in range(2):
        a, b, c = angles[:, p, :].T
        q[:, 2 * p] = np.cos(a) * np.cos(c) - np.sin(a) * np.sin(b) * np.sin(c)
        q[:, 2 * p + 1] = np.cos(a) * np.cos(b)
    yideal = t[:, None] * q
    yideal[:, 0] += 1
    A = np.diag([-0.2] * 4)
    for l in range(4):
        if l:
            A[l, l - 1] = l / (2 * l + 1)
        if l < 3:
            A[l, l + 1] = -(l + 1) / (2 * l + 1)
    ref = np.array([expm(A * x)[:, 0] for x in t])
    y = d["moments"]
    err = y - ref
    se = d["moment_stds"]
    assert np.allclose(ref, d["classical"], atol=1e-14)
    assert np.allclose(y, t[:, None] * d["expectations"] + np.array([1, 0, 0, 0]))
    assert np.allclose(se, t[:, None] * d["stds"])
    assert np.isclose(np.mean(err**2), m["mse_against_P3"])
    shots = np.array([x["shots"] for x in m["pub_metadata"]]).reshape(len(t), 2)
    S = np.repeat(shots, 2, axis=1)
    ideal_mse = float(np.mean((yideal - ref) ** 2))
    expected_shot_mse = ideal_mse + float(np.mean(t[:, None] ** 2 * (1 - q * q) / S))
    stats = {
        "job_id": m["job_id"],
        "mse": float(np.mean(err**2)),
        "rmse": float(np.sqrt(np.mean(err**2))),
        "mse_excluding_initial": float(np.mean(err[1:] ** 2)),
        "ideal_same_grid_mse": ideal_mse,
        "expected_ideal_shot_mse": expected_shot_mse,
        "hardware_to_shot_ratio": float(np.mean(err**2) / expected_shot_mse),
        "mean_estimated_sampling_variance": float(np.mean(se**2)),
        "per_moment_mse": np.mean(err**2, axis=0).tolist(),
        "per_moment_rmse": np.sqrt(np.mean(err**2, axis=0)).tolist(),
        "per_moment_max_absolute_error": np.max(abs(err), axis=0).tolist(),
        "per_moment_mean_signed_error": np.mean(err, axis=0).tolist(),
    }
    (base / "hardware_analysis.json").write_text(json.dumps(stats, indent=2))
    with (base / "hardware_comparison.csv").open("w") as f:
        w = csv.writer(f)
        w.writerow(
            [
                "t",
                "moment",
                "ideal",
                "classical_P3",
                "IBM",
                "standard_error",
                "difference",
            ]
        )
        for i, x in enumerate(t):
            for l in range(4):
                w.writerow(
                    [x, l, yideal[i, l], ref[i, l], y[i, l], se[i, l], err[i, l]]
                )
    plt.rcParams.update(
        {"font.size": 10, "axes.spines.top": False, "axes.spines.right": False}
    )
    fig, axs = plt.subplots(2, 2, figsize=(9, 6), sharex=True)
    for l, ax in enumerate(axs.flat):
        ax.plot(t, ref[:, l], color="#234e70", label="Classical P3 / ideal circuit")
        ax.errorbar(
            t,
            y[:, l],
            yerr=se[:, l],
            fmt="o",
            ms=3,
            capsize=2,
            color="#c65924",
            label="IBM fez: 1 standard error",
        )
        ax.set(ylabel=f"$M_{l}(t)$")
        ax.grid(alpha=0.15)
        if l >= 2:
            ax.set_xlabel("t (dimensionless)")
    axs[0, 0].legend(fontsize=8)
    fig.tight_layout()
    fig.savefig(base / "ibm_moments.pdf")
    plt.close(fig)
    fig, axs = plt.subplots(2, 2, figsize=(9, 5.5), sharex=True)
    for l, ax in enumerate(axs.flat):
        ax.axhline(0, color="#234e70", lw=1)
        ax.errorbar(
            t, err[:, l], yerr=se[:, l], fmt="o", ms=3, capsize=2, color="#c65924"
        )
        ax.set(ylabel=f"$M_{l}^{{IBM}}-M_{l}^{{P_3}}$")
        ax.grid(alpha=0.15)
        if l >= 2:
            ax.set_xlabel("t (dimensionless)")
    fig.tight_layout()
    fig.savefig(base / "ibm_errors.pdf")
    plt.close(fig)
    print(json.dumps(stats, indent=2))


