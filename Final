def save_result(result, manifest, folder):
    t = np.asarray(manifest["times"])
    evs = np.asarray([np.asarray(r.data.evs).ravel() for r in result]).reshape(
        len(t), 4
    )
    stds = np.asarray([np.asarray(r.data.stds).ravel() for r in result]).reshape(
        len(t), 4
    )
    y = t[:, None] * evs
    y[:, 0] += 1
    ref = classical(3, t)
    manifest.update(
        completed_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        mse_against_P3=float(np.mean((y - ref) ** 2)),
        pub_metadata=[r.metadata for r in result],
        result_metadata=result.metadata,
    )
    np.savez(
        folder / "ibm_values.npz",
        t=t,
        expectations=evs,
        stds=stds,
        moment_stds=t[:, None] * stds,
        moments=y,
        classical=ref,
    )
    (folder / "ibm_result.json").write_text(json.dumps(manifest, indent=2, default=str))
    print("MSE against finite P3 reference:", manifest["mse_against_P3"])
    print("Results saved in:", folder)


def run_hardware(args):
    from qiskit_ibm_runtime import QiskitRuntimeService

    service = (
        QiskitRuntimeService(name=args.account)
        if args.account
        else QiskitRuntimeService()
    )
    if args.resume:
        path = args.resume.resolve()
        manifest = json.loads(path.read_text())
        job = service.job(manifest["job_id"])
        print("Existing job status:", job.status(), flush=True)
        save_result(job.result(), manifest, path.parent)
        return
    from qiskit import QuantumCircuit, qpy
    from qiskit.circuit import ParameterVector
    from qiskit.quantum_info import SparsePauliOp
    from qiskit.transpiler import generate_preset_pass_manager

    try:
        from qiskit_ibm_runtime.server_side import EstimatorV2 as Estimator
    except ImportError:
        from qiskit_ibm_runtime import EstimatorV2 as Estimator
    base = BASE
    raw = (base / "results.json").read_bytes()
    model = json.loads(raw)["models"][2]
    backend = (
        service.backend(args.backend)
        if args.backend
        else service.least_busy(operational=True, simulator=False, min_num_qubits=2)
    )
    if backend.configuration().simulator:
        raise ValueError("A real QPU is required.")
    p = ParameterVector("angle", 3)
    qc = QuantumCircuit(2)
    qc.ry(p[0], 0)
    qc.ry(p[1], 1)
    qc.cx(0, 1)
    qc.ry(p[2], 0)
    isa = generate_preset_pass_manager(
        optimization_level=1, backend=backend, seed_transpiler=71
    ).run(qc)
    observables = [SparsePauliOp(s).apply_layout(isa.layout) for s in ["IZ", "ZI"]]
    t = np.linspace(0, 2, args.points)
    V, _ = features(t, 5)
    theta = np.asarray(model["theta"]).reshape(2, 3, 6)
    angles = np.einsum("td,pgd->tpg", V, theta)
    pubs = []
    for i in range(len(t)):
        for pair in range(2):
            mapping = dict(zip(p, angles[i, pair]))
            pubs.append(
                (isa, observables, [mapping[param] for param in isa.parameters])
            )
    options = {
        "resilience_level": 0,
        "max_execution_time": args.max_seconds,
        "twirling": {"enable_gates": False, "enable_measure": False},
        "dynamical_decoupling": {"enable": False},
    }
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    folder = base / "ibm_runs" / stamp
    folder.mkdir(parents=True)
    with (folder / "isa_circuit.qpy").open("wb") as f:
        qpy.dump(isa, f)
    manifest = {
        "backend": backend.name,
        "times": t.tolist(),
        "theta": theta.tolist(),
        "results_sha256": hashlib.sha256(raw).hexdigest(),
        "precision_requested": args.precision,
        "options": options,
        "optimization_level": 1,
        "seed_transpiler": 71,
        "isa_depth": isa.depth(),
        "isa_ops": dict(isa.count_ops()),
        "final_index_layout": isa.layout.final_index_layout(),
        "versions": {
            n: importlib.metadata.version(n) for n in ["qiskit", "qiskit-ibm-runtime"]
        },
    }
    (folder / "planned_run.json").write_text(
        json.dumps(manifest, indent=2, default=str)
    )
    print("Submitting", len(pubs), "PUBs to", backend.name, flush=True)
    job = Estimator(mode=backend, options=options).run(pubs, precision=args.precision)
    manifest.update(
        job_id=job.job_id(),
        submitted_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    )
    path = folder / "ibm_submission.json"
    path.write_text(json.dumps(manifest, indent=2, default=str))
    print("Submitted job:", job.job_id(), "\nResume manifest:", path, flush=True)
    save_result(job.result(), manifest, folder)


