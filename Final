# 1. CLASSICAL REFERENCES, CIRCUIT READOUTS AND LOCAL TRAINING
# ========================================================================


def matrix(N, k=1.0, nu=0.2):
    A = -nu * np.eye(N + 1)
    for l in range(N + 1):
        if l:
            A[l, l - 1] = k * l / (2 * l + 1)
        if l < N:
            A[l, l + 1] = -k * (l + 1) / (2 * l + 1)
    return A


def classical(N, t):
    e = np.eye(N + 1)[:, 0]
    return np.array([expm(matrix(N) * x) @ e for x in t])


def infinite(N, t):
    return np.exp(-0.2 * np.asarray(t)[:, None]) * np.stack(
        [spherical_jn(l, t) for l in range(N + 1)], axis=1
    )


def features(t, d):
    z = np.asarray(t) - 1
    V = np.stack([z**j for j in range(d + 1)], axis=1)
    D = np.stack(
        [np.zeros_like(z)] + [j * z ** (j - 1) for j in range(1, d + 1)], axis=1
    )
    return V, D


def evaluate(theta, t, m, kind="single", degree=5, return_q=False):
    V, D = features(t, degree)
    if kind == "single":
        th = np.asarray(theta).reshape(m, degree + 1)
        a = V @ th.T
        ad = D @ th.T
        q = np.cos(a)
        qd = -np.sin(a) * ad
    else:
        th = np.asarray(theta).reshape(m // 2, 3, degree + 1)
        a, b, c = np.einsum("td,pgd->gtp", V, th)
        ad, bd, cd = np.einsum("td,pgd->gtp", D, th)
        ca, sa, cb, sb, cc, sc = (
            np.cos(a),
            np.sin(a),
            np.cos(b),
            np.sin(b),
            np.cos(c),
            np.sin(c),
        )
        if kind == "entangled":
            q0 = ca * cc - sa * sb * sc
            q1 = ca * cb
            q0d = (
                -sa * ad * cc
                - ca * sc * cd
                - ca * ad * sb * sc
                - sa * cb * bd * sc
                - sa * sb * cc * cd
            )
            q1d = -sa * ad * cb - ca * sb * bd
        else:
            q0 = np.cos(a + c)
            q1 = cb
            q0d = -np.sin(a + c) * (ad + cd)
            q1d = -sb * bd
        q = np.stack([q0, q1], axis=2).reshape(len(t), m)
        qd = np.stack([q0d, q1d], axis=2).reshape(len(t), m)
    if return_q:
        return q, qd
    y = np.asarray(t)[:, None] * q
    y[:, 0] += 1
    return y, q + np.asarray(t)[:, None] * qd


def fit(N, kind, degree=5, seeds=(11, 22, 33)):
    m = N + 1
    t = np.linspace(0, 2, 41)
    A = matrix(N)
    n = m * (degree + 1) if kind == "single" else (m // 2) * 3 * (degree + 1)
    runs = []
    best = None
    for seed in seeds:
        rng = np.random.default_rng(seed)
        p = rng.normal(0, 0.08, n)
        if kind == "single":
            p.reshape(m, -1)[:, 0] = [1.9] + [1.2] * (m - 1)
        else:
            p.reshape(m // 2, 3, -1)[:, :, 0] = np.array([1.2, 0.8, 1.0])

        def residual(th):
            y, dy = evaluate(th, t, m, kind, degree)
            return (dy - y @ A.T).ravel()

        start = time.perf_counter()
        r = least_squares(
            residual,
            p,
            method="trf",
            jac="3-point",
            ftol=1e-11,
            xtol=1e-11,
            gtol=1e-11,
            max_nfev=700,
        )
        run = {
            "seed": seed,
            "loss": float(np.mean(r.fun**2)),
            "nfev": r.nfev,
            "optimality": float(r.optimality),
            "status": int(r.status),
            "seconds": time.perf_counter() - start,
        }
        runs.append(run)
        if best is None or run["loss"] < best[0]:
            best = (run["loss"], r.x)
    grid = np.linspace(0, 2, 201)
    y, dy = evaluate(best[1], grid, m, kind, degree)
    ref = classical(N, grid)
    exact = infinite(N, grid)
    return {
        "N": N,
        "kind": kind,
        "degree": degree,
        "parameters": n,
        "theta": best[1].tolist(),
        "runs": runs,
        "mse": float(np.mean((y - ref) ** 2)),
        "max_abs": float(np.max(abs(y - ref))),
        "residual_rms": float(np.sqrt(np.mean((dy - y @ matrix(N).T) ** 2))),
        "physical_mse": float(np.mean((y - exact) ** 2)),
    }


def train_local():
    out = {
        "versions": {
            "python": platform.python_version(),
            "numpy": np.__version__,
            "scipy": scipy.__version__,
        },
        "models": [],
    }
    # Original benchmark is refitted from its printed, rounded parameter vector.
    x = np.linspace(0, 2, 41)
    test = np.linspace(0, 2, 201)
    initial = np.array([3.42346, 1.98998, -1.71461, 1.04958, -0.35142, 0.04778])

    def scalar(th, t):
        ph = np.polynomial.polynomial.polyval(t, th)
        dph = np.polynomial.polynomial.polyval(t, np.arange(1, 6) * th[1:])
        q = np.cos(ph)
        y = 1 + t * (q - 1) / 2
        dy = (q - 1) / 2 - t * np.sin(ph) * dph / 2
        return y, dy, q

    r = least_squares(
        lambda th: sum(scalar(th, x)[:2]),
        initial,
        method="trf",
        jac="3-point",
        ftol=1e-13,
        xtol=1e-13,
        gtol=1e-13,
        max_nfev=2000,
    )
    y, dy, q = scalar(r.x, test)
    out["scalar"] = {
        "theta": r.x.tolist(),
        "mse": float(np.mean((y - np.exp(-test)) ** 2)),
        "residual_rms": float(np.sqrt(np.mean((dy + y) ** 2))),
        "nfev": r.nfev,
    }
    far = np.linspace(0, 6, 601)
    yf, _, _ = scalar(r.x, far)
    fig, ax = plt.subplots(1, 2, figsize=(10, 3.3))
    ax[0].plot(test, np.exp(-test), label="Exact")
    ax[0].plot(test, y, "--", label="Residual-trained circuit")
    ax[0].set(xlabel="x (dimensionless)", ylabel="y(x)")
    ax[0].legend()
    ax[1].plot(far, np.exp(-far), label="Exact")
    ax[1].plot(far, yf, label="Same trained parameters")
    ax[1].axvspan(0, 2, alpha=0.12, color="gray", label="Training interval")
    ax[1].set(xlabel="x (dimensionless)", ylabel="y(x)", ylim=(-5, 1.2))
    ax[1].legend(fontsize=8)
    fig.tight_layout()
    fig.savefig(BASE / "figures/scalar.pdf")
    plt.close(fig)
    # Independent shot replicates, not hardware noise.
    shot = []
    rng = np.random.default_rng(20261102)
    for S in [256, 1024, 4096, 16384]:
        estimates = rng.binomial(S, (1 + q) / 2, size=(200, len(q))) * 2 / S - 1
        ys = 1 + test[None, :] * (estimates - 1) / 2
        vals = np.mean((ys - np.exp(-test)) ** 2, axis=1)
        shot.append(
            {
                "shots": S,
                "mean_mse": float(vals.mean()),
                "sd_mse": float(vals.std(ddof=1)),
                "predicted_mse": float(
                    out["scalar"]["mse"] + np.mean(test**2 * (1 - q * q)) / (4 * S)
                ),
            }
        )
    out["shots"] = shot
    for N, kind in [(1, "single"), (3, "single"), (3, "entangled"), (3, "product")]:
        res = fit(N, kind)
        out["models"].append(res)
        (BASE / "results.json").write_text(json.dumps(out, indent=2))
        print(N, kind, res["mse"], res["residual_rms"], flush=True)
    out["closure"] = []
    for N in [1, 2, 3, 5, 7]:
        yy = classical(N, test)
        xx = infinite(N, test)
        out["closure"].append(
            {
                "N": N,
                "all_mse": float(np.mean((yy - xx) ** 2)),
                "m0_max": float(np.max(abs(yy[:, 0] - xx[:, 0]))),
                "first_two_mse": float(np.mean((yy[:, :2] - xx[:, :2]) ** 2)),
            }
        )
    fig, axs = plt.subplots(2, 2, figsize=(10, 6), sharex=True)
    model = out["models"][2]
    v, d = evaluate(model["theta"], test, 4, "entangled")
    ref = classical(3, test)
    true = infinite(3, test)
    for j, ax in enumerate(axs.flat):
        ax.plot(test, true[:, j], label="Infinite hierarchy")
        ax.plot(test, ref[:, j], "--", label="Classical P3")
        ax.plot(test, v[:, j], ":", lw=2, label="Two-qubit ansatz")
        ax.set(xlabel="t (dimensionless)", ylabel=f"M{j}(t)")
        ax.legend(fontsize=7)
    fig.tight_layout()
    fig.savefig(BASE / "figures/hierarchy.pdf")
    plt.close(fig)
    fig, ax = plt.subplots(1, 2, figsize=(10, 3.2))
    for N in [1, 2, 3, 5]:
        ax[0].semilogy(
            test,
            np.maximum(abs(classical(N, test)[:, 0] - infinite(N, test)[:, 0]), 1e-16),
            label=f"P{N}",
        )
    ax[0].set(xlabel="t (dimensionless)", ylabel="Absolute closure error in M0")
    ax[0].legend()
    for mo in out["models"]:
        if mo["N"] == 3:
            yy, _ = evaluate(mo["theta"], test, 4, mo["kind"])
            ax[1].semilogy(
                test,
                np.maximum(np.linalg.norm(yy - ref, axis=1), 1e-16),
                label=mo["kind"],
            )
    ax[1].set(xlabel="t (dimensionless)", ylabel="Euclidean error against classical P3")
    ax[1].legend()
    fig.tight_layout()
    fig.savefig(BASE / "figures/errors.pdf")
    plt.close(fig)
    # Entanglement before the final local rotation; concurrence is invariant under it.
    th = np.asarray(model["theta"]).reshape(2, 3, 6)
    V, _ = features(test, 5)
    a, b, c = np.einsum("td,pgd->gtp", V, th)
    con = abs(np.sin(a) * np.cos(b))
    out["entanglement"] = {
        "mean_concurrence": con.mean(axis=0).tolist(),
        "max_concurrence": con.max(axis=0).tolist(),
    }
    # Explicit independent 4-amplitude statevector check of the analytic readouts.
    maxdiff = 0
    for p in range(2):
        for ix in range(0, 201, 20):
            aa, bb, cc = a[ix, p], b[ix, p], c[ix, p]
            R = lambda z: np.array(
                [[np.cos(z / 2), -np.sin(z / 2)], [np.sin(z / 2), np.cos(z / 2)]]
            )
            state = np.kron(R(aa)[:, 0], R(bb)[:, 0])
            state = state[[0, 1, 3, 2]]
            state = np.kron(R(cc), np.eye(2)) @ state
            qq = np.array(
                [np.dot(state**2, [1, 1, -1, -1]), np.dot(state**2, [1, -1, 1, -1])]
            )
            analytic = evaluate(
                model["theta"], test[[ix]], 4, "entangled", return_q=True
            )[0][0, 2 * p : 2 * p + 2]
            maxdiff = max(maxdiff, float(np.max(abs(qq - analytic))))
    out["checks"] = {"statevector_readout_max_error": maxdiff}
    (BASE / "results.json").write_text(json.dumps(out, indent=2))
    print("DONE", json.dumps(out["checks"]), flush=True)


