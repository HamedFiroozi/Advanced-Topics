def restore_archives():
    BASE.mkdir(parents=True, exist_ok=True)
    (BASE / "figures").mkdir(exist_ok=True)
    for name in ("results.json", "report_reference_results.json"):
        (BASE / name).write_text(json.dumps(ARCHIVED_LOCAL_RESULTS, indent=2))
    for name, entry in ARCHIVED_IBM_RUNS.items():
        folder = BASE / "hardware_data" / name
        folder.mkdir(parents=True, exist_ok=True)
        (folder / "ibm_result.json").write_text(json.dumps(entry["metadata"], indent=2))
        np.savez(
            folder / "ibm_values.npz",
            **{k: np.asarray(v) for k, v in entry["arrays"].items()},
        )


def main():
    global BASE
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    action = parser.add_mutually_exclusive_group()
    action.add_argument(
        "--retrain",
        action="store_true",
        help="Repeat local fitting; may take several minutes.",
    )
    action.add_argument(
        "--analyze-only",
        action="store_true",
        help="Analyze embedded IBM measurements only.",
    )
    action.add_argument(
        "--execute", action="store_true", help="Submit a NEW real QPU job."
    )
    action.add_argument(
        "--resume", type=Path, help="Retrieve an existing job using its saved manifest."
    )
    parser.add_argument("--output-dir", type=Path, default=BASE)
    parser.add_argument("--account", help="Optional named locally saved IBM account.")
    parser.add_argument("--backend")
    parser.add_argument("--points", type=int, default=21)
    parser.add_argument("--precision", type=float, default=1 / 64)
    parser.add_argument("--max-seconds", type=int, default=120)
    args = parser.parse_args()
    if (
        args.points < 2
        or not np.isfinite(args.precision)
        or args.precision <= 0
        or args.max_seconds <= 0
    ):
        parser.error("Require points >= 2, finite precision > 0 and max-seconds > 0.")
    if not (args.execute or args.resume or args.analyze_only):
        try:
            import qiskit
        except ImportError:
            parser.error(
                "Install qiskit, or use --analyze-only for offline IBM analysis without it."
            )
    BASE = args.output_dir.expanduser().resolve()
    restore_archives()
    print("Output directory:", BASE, flush=True)
    if args.execute or args.resume:
        run_hardware(args)
        return
    if not args.analyze_only:
        if args.retrain:
            print("Retraining locally; no QPU job is submitted.", flush=True)
            train_local()
        else:
            print(
                "Using archived trained coefficients; no retraining and no QPU submission.",
                flush=True,
            )
            plot_saved_results()
        verify_local()
    print("Analyzing archived real IBM measurements.", flush=True)
    analyze_hardware()


