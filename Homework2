Codercise I.3.2
“””

@qml.qnode(dev)
def parametrized_circuit(theta):
    # Define a parametrized unitary matrix U(theta)
    U = np.array([[np.cos(theta), -np.sin(theta)], 
                  [np.sin(theta),  np.cos(theta)]])
    qml.QubitUnitary(U, wires=0)
    return qml.state()

