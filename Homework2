import numpy as np

# Applying an arbitrary unitary matrix U
U = np.array([[1, 1], [1, -1]]) / np.sqrt(2)

@qml.qnode(dev)
def apply_u():
    qml.QubitUnitary(U, wires=0)
    return qml.state()

