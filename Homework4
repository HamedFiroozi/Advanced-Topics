dev = qp.device("default.qubit", wires=3)
state = [0, 1]
@qp.qnode(device=dev)
def apply_control_sequence(state):
    if state[0] == 1:
        qp.PauliX(wires=0)
    if state[1] == 1:
        qp.PauliX(wires=1)
    qp.PauliX(wires=2)
    qp.Hadamard(wires=2)
    qp.ctrl(qp.PauliX, control=[0, 1],
            control_values=[0, 1])(wires=2)
    qp.ctrl(qp.PauliZ, control=[0, 1],
            control_values=[1, 0])(wires=2)
    qp.ctrl(qp.PauliY, control=[0, 1],
            control_values=[1, 1])(wires=2)
    return qp.state()
print(apply_control_sequence(state))


