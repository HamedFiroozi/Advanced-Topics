    return my_array
@qp.qnode(dev)
def multisol_pair_circuit(x_tilde, combos):
    for i in range(n_bits - 1):
        if x_tilde[i] == 1:
            qp.PauliX(wires=i)
    qp.Hadamard(wires=n_bits - 1)
    qp.QubitUnitary(
        multisol_oracle_matrix(combos),
        wires=range(n_bits)
    )
    qp.Hadamard(wires=n_bits - 1)
    return qp.probs(wires=n_bits - 1)

