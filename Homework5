        qml.SWAP(wires=[i, n_qubits - i - 1])
def qft_rotations(n_qubits):
    for target in range(n_qubits):
        qml.Hadamard(wires=target)
        for control in range(target + 1, n_qubits):
            angle = 2 * np.pi / (2 ** (control - target + 1))
            qml.ControlledPhaseShift(
                angle,
                wires=[control, target]
            )
@qml.qnode(dev)
def qft_node(basis_id, n_qubits):
    bits = [int(x) for x in np.binary_repr(basis_id, width=n_qubits)]
    qml.BasisState(bits, wires=range(n_qubits))
    qft_rotations(n_qubits)
    swap_bits(n_qubits)
    return qml.state()
