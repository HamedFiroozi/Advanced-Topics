def grover_circuit(combo, num_steps):
    for wire in range(n_bits):
        qml.Hadamard(wires=wire)
    for step in range(num_steps):
        qml.QubitUnitary(
            oracle_matrix(combo),
            wires=range(n_bits)
        )
        qml.QubitUnitary(
            diffusion_matrix(),
            wires=range(n_bits)
        )
    return qml.state()
