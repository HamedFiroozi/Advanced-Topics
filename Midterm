# ============================================================
# 12. TRUNCATED MOMENTUM HIERARCHY - FINAL PROJECT SCAFFOLD
# ============================================================

# Generic linearized form:
#     dM/dt = A(t) M(t) + b(t)
#
# Residual:
#     R(t;theta) = dM_theta/dt - A(t)M_theta(t) - b(t)
#
# The physical hierarchy, truncation order, closure relation, A(t), b(t),
# and initial conditions must come from the specific final-project model.


def hierarchy_residual(M, dMdt, A, b):
    """Generic vector residual R=dM/dt-A M-b."""
    M = np.asarray(M, dtype=float)
    dMdt = np.asarray(dMdt, dtype=float)
    A = np.asarray(A, dtype=float)
    b = np.asarray(b, dtype=float)

    return dMdt - A @ M - b


def hierarchy_cost(residuals):
    """Mean squared L2 norm of hierarchy residual vectors."""
    residuals = np.asarray(residuals, dtype=float)
    return float(np.mean(np.sum(residuals**2, axis=1)))


